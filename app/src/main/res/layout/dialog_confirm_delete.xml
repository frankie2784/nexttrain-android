<?xml version="1.0" encoding="utf-8"?>
<!-- Route delete confirmation (ConfigActivity.confirmDeletePair). Whole dialog
     content, matching dialog_choose_region.xml — the builder sets only setView().
     Cancel / Delete use the same outlined + filled pair, at the same 1 : 1.4
     weighting, as the route editor sheet's Cancel / Save row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/nt_gutter_wide"
    android:paddingEnd="@dimen/nt_gutter_wide"
    android:paddingTop="22dp"
    android:paddingBottom="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="@string/delete_route_title"
        android:textSize="19sp"
        style="@style/NT.Text.Title" />

    <TextView
        android:id="@+id/tv_delete_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        style="@style/NT.Text.Body" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:text="@string/cancel"
            style="@style/Widget.NT.Button.Outlined" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete_confirm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.4"
            android:text="@string/delete"
            app:icon="@drawable/ic_delete"
            app:iconSize="18dp"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/nt_on_danger"
            style="@style/Widget.NT.Button.Danger" />
    </LinearLayout>
</LinearLayout>
