<?xml version="1.0" encoding="utf-8"?>
<!-- Route editor. Was an AlertDialog with two bare Spinners; now a bottom sheet.
     Ids kept identical to dialog_od_pair.xml so existing binding code still works,
     plus et_label / spinner_origin / spinner_destination unchanged. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@color/nt_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/nt_gutter_wide"
        android:paddingEnd="@dimen/nt_gutter_wide"
        android:paddingTop="10dp"
        android:paddingBottom="20dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@color/nt_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_sheet_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/edit_route"
                android:textSize="18sp"
                style="@style/NT.Text.Title" />

            <ImageButton
                android:id="@+id/btn_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                app:tint="@color/nt_muted"
                android:contentDescription="@string/cd_close" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="7dp"
            android:text="@string/label"
            style="@style/NT.Text.Eyebrow" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="@string/label_hint"
            style="@style/Widget.NT.TextField">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/nt_text"
                android:singleLine="true"
                android:inputType="textCapSentences"
                android:imeOptions="actionDone" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="7dp"
            android:text="@string/line"
            style="@style/NT.Text.Eyebrow" />

        <!-- Optional line filter: when set, origin/destination below are limited to this
             line's stations and ordered by physical position instead of alphabetically. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/nt_field_bg">

            <ImageView
                android:id="@+id/dot_line_color"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="14dp"
                android:src="@drawable/shape_line_color_dot"
                app:tint="@color/nt_muted"
                android:contentDescription="@null" />

            <Spinner
                android:id="@+id/spinner_line"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/nt_touch_min"
                android:background="@null" />

            <ImageView
                android:id="@+id/iv_dropdown_line"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_unfold_more"
                app:tint="@color/nt_muted"
                android:contentDescription="@null"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="7dp"
            android:text="@string/journey"
            style="@style/NT.Text.Eyebrow" />

        <!-- Origin and destination read as one journey, not two unrelated fields. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/nt_field_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_marginEnd="11dp"
                    android:src="@drawable/ic_trip_origin"
                    app:tint="@color/nt_primary"
                    android:contentDescription="@null" />

                <Spinner
                    android:id="@+id/spinner_origin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/nt_touch_min"
                    android:background="@null" />

                <ImageView
                    android:id="@+id/iv_dropdown_origin"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_unfold_more"
                    app:tint="@color/nt_muted"
                    android:contentDescription="@null"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="42dp"
                android:background="@color/nt_divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_marginEnd="11dp"
                    android:src="@drawable/ic_place"
                    app:tint="@color/nt_primary"
                    android:contentDescription="@null" />

                <Spinner
                    android:id="@+id/spinner_destination"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/nt_touch_min"
                    android:background="@null" />

                <ImageView
                    android:id="@+id/iv_dropdown_destination"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_unfold_more"
                    app:tint="@color/nt_muted"
                    android:contentDescription="@null"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless" />
            </LinearLayout>
        </LinearLayout>

        <!-- Inline validation, replacing the two Toasts. -->
        <TextView
            android:id="@+id/tv_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:textColor="@color/nt_late"
            android:visibility="gone"
            style="@style/NT.Text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="18dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/show_on_widget"
                    android:textSize="14sp"
                    style="@style/NT.Text.CardTitle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/show_on_widget_body"
                    android:textColor="@color/nt_sub"
                    style="@style/NT.Text.Caption" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_include_on_widget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/notifications"
                    android:textSize="14sp"
                    style="@style/NT.Text.CardTitle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/notifications_body"
                    android:textColor="@color/nt_sub"
                    style="@style/NT.Text.Caption" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_route_notifications"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/notification_details_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="7dp"
                android:text="@string/active_window"
                style="@style/NT.Text.Eyebrow" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/nt_field_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/from"
                        android:textSize="10.5sp"
                        style="@style/NT.Text.Caption" />

                    <TextView
                        android:id="@+id/tv_time_from"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="06:00"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFeatureSettings="tnum"
                        style="@style/NT.Text" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="@color/nt_muted"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/nt_field_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/to"
                        android:textSize="10.5sp"
                        style="@style/NT.Text.Caption" />

                    <TextView
                        android:id="@+id/tv_time_to"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10:00"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFeatureSettings="tnum"
                        style="@style/NT.Text" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/active_days"
                style="@style/NT.Text.Eyebrow" />

            <!-- Seven circles. No MaterialButtonToggleGroup: it forces a joined bar. -->
            <LinearLayout
                android:id="@+id/day_toggle_group"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="18dp"
                android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cb_sun"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/day_sun"
                android:checkable="true"
                style="@style/Widget.NT.DayToggle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cb_mon"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/day_mon"
                android:checkable="true"
                style="@style/Widget.NT.DayToggle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cb_tue"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/day_tue"
                android:checkable="true"
                style="@style/Widget.NT.DayToggle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cb_wed"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/day_wed"
                android:checkable="true"
                style="@style/Widget.NT.DayToggle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cb_thu"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/day_thu"
                android:checkable="true"
                style="@style/Widget.NT.DayToggle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cb_fri"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/day_fri"
                android:checkable="true"
                style="@style/Widget.NT.DayToggle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cb_sat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/day_sat"
                android:checkable="true"
                style="@style/Widget.NT.DayToggle" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/nt_divider" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:text="@string/cancel"
                style="@style/Widget.NT.Button.Outlined" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.4"
                android:text="@string/save_route"
                style="@style/Widget.NT.Button" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
