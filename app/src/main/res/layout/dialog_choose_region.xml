<?xml version="1.0" encoding="utf-8"?>
<!-- First-launch region prompt (ConfigActivity.maybeShowRegionPrompt).
     This is the dialog's *entire* content: title, body and action all live here
     rather than in the builder, so the prompt uses the app's own vocabulary
     (icon tile, eyebrow, nt_field_bg field, Widget.NT.Button) instead of stock
     Material alert chrome. The builder therefore sets neither title, message
     nor buttons — only setView(). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/nt_gutter_wide"
    android:paddingEnd="@dimen/nt_gutter_wide"
    android:paddingTop="22dp"
    android:paddingBottom="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="@string/choose_region_title"
        android:textSize="19sp"
        style="@style/NT.Text.Title" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/choose_region_body"
        android:textSize="13.5sp"
        style="@style/NT.Text.Body" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="@drawable/nt_field_bg">

        <ImageView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_marginEnd="11dp"
            android:src="@drawable/ic_place"
            app:tint="@color/nt_primary"
            android:contentDescription="@null" />

        <Spinner
            android:id="@+id/spinner_region_dialog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="@dimen/nt_touch_min"
            android:background="@null" />

        <ImageView
            android:id="@+id/iv_dropdown_region_dialog"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_unfold_more"
            app:tint="@color/nt_muted"
            android:contentDescription="@null"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_region_continue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/continue_label"
        style="@style/Widget.NT.Button" />
</LinearLayout>
