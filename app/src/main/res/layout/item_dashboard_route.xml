<?xml version="1.0" encoding="utf-8"?>
<!-- Dashboard row for a route that is not currently in its active window. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    style="@style/Widget.NT.Card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:padding="@dimen/nt_card_padding">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_dash_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:text="Evening commute"
                style="@style/NT.Text.CardTitle" />

            <TextView
                android:id="@+id/tv_dash_route"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jolimont-MCG ➝ Fairfield"
                android:textSize="12.5sp"
                style="@style/NT.Text.Body" />

            <TextView
                android:id="@+id/tv_dash_window"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="active Mon–Fri 15:30–19:30"
                style="@style/NT.Text.Caption" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dash_metrics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical"
            android:gravity="end">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <com.nexttrain.ui.RollingTextView
                    android:id="@+id/tv_dash_mins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="22"
                    style="@style/NT.Text.Number" />

                <TextView
                    android:id="@+id/tv_dash_mins_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="@string/min"
                    android:textSize="12sp"
                    android:textColor="@color/nt_sub"
                    style="@style/NT.Text" />
            </LinearLayout>

            <com.nexttrain.ui.RollingTextView
                android:id="@+id/tv_dash_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="08:20"
                android:textColor="@color/nt_sub"
                android:fontFeatureSettings="tnum"
                style="@style/NT.Text.Caption" />

            <TextView
                android:id="@+id/tv_dash_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="6 min late"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:textColor="@color/nt_late"
                style="@style/NT.Text" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/edit_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btn_row_reorder"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/nt_icon_tile"
                android:src="@drawable/ic_unfold_more"
                android:scaleType="centerInside"
                app:tint="@color/nt_sub"
                android:contentDescription="@string/cd_reorder_route" />

            <ImageButton
                android:id="@+id/btn_row_delete"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/nt_icon_tile"
                android:src="@drawable/ic_delete"
                android:scaleType="centerInside"
                app:tint="@color/nt_sub"
                android:contentDescription="@string/cd_delete_route" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
