<?xml version="1.0" encoding="utf-8"?>
<!-- Route departures. One hero card for the next train, a list for the rest. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/nt_bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:paddingStart="@dimen/nt_gutter"
        android:paddingEnd="@dimen/nt_gutter">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/nt_icon_button_bg"
            android:src="@drawable/ic_arrow_back"
            android:scaleType="centerInside"
            app:tint="@color/nt_text"
            android:contentDescription="@string/cd_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_route_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Morning commute"
                style="@style/NT.Text.CardTitle" />

            <TextView
                android:id="@+id/tv_route_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Fairfield ➝ Jolimont-MCG"
                android:textSize="12sp"
                style="@style/NT.Text.Body" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_edit_route"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/nt_icon_button_bg"
            android:src="@drawable/ic_edit"
            android:scaleType="centerInside"
            app:tint="@color/nt_text"
            android:contentDescription="@string/cd_edit_route" />
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Hero: next departure -->
                <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/nt_gutter"
                android:layout_marginEnd="@dimen/nt_gutter"
                android:layout_marginTop="4dp"
                app:cardCornerRadius="22dp"
                style="@style/Widget.NT.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="22dp"
                    android:paddingBottom="22dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:text="@string/next_departure"
                        style="@style/NT.Text.Eyebrow" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom">

                        <com.nexttrain.ui.RollingTextView
                            android:id="@+id/tv_hero_mins"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="8"
                            style="@style/NT.Text.Display" />

                        <TextView
                            android:id="@+id/tv_hero_mins_unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginBottom="8dp"
                            android:text="@string/min"
                            android:textSize="22sp"
                            android:textColor="@color/nt_sub"
                            style="@style/NT.Text" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        android:gravity="top">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="8dp"
                            android:layout_marginTop="2dp"
                            android:src="@drawable/ic_schedule"
                            app:tint="@color/nt_muted"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="top">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <com.nexttrain.ui.RollingTextView
                                    android:id="@+id/tv_hero_departs"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Departs 08:06"
                                    android:textSize="13.5sp"
                                    android:fontFeatureSettings="tnum"
                                    style="@style/NT.Text" />

                                <TextView
                                    android:id="@+id/tv_hero_origin"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Fairfield"
                                    android:textSize="12sp"
                                    android:textColor="@color/nt_sub"
                                    style="@style/NT.Text" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tv_hero_arrives"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Arrives 08:31"
                                    android:textSize="13.5sp"
                                    android:fontFeatureSettings="tnum"
                                    style="@style/NT.Text" />

                                <TextView
                                    android:id="@+id/tv_hero_destination"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Jolimont-MCG"
                                    android:textSize="12sp"
                                    android:textColor="@color/nt_sub"
                                    style="@style/NT.Text" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:id="@+id/chip_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/nt_chip_ok"
                            android:paddingStart="11dp"
                            android:paddingEnd="11dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp">

                            <ImageView
                                android:id="@+id/iv_status"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginEnd="5dp"
                                android:src="@drawable/ic_check_circle"
                                app:tint="@color/nt_primary"
                                android:contentDescription="@null" />

                            <TextView
                                android:id="@+id/tv_hero_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/on_time"
                                android:textSize="11.5sp"
                                android:textStyle="bold"
                                android:textColor="@color/nt_primary"
                                style="@style/NT.Text" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/chip_platform"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/nt_chip_neutral"
                            android:paddingStart="11dp"
                            android:paddingEnd="11dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginEnd="5dp"
                                android:src="@drawable/ic_signpost"
                                app:tint="@color/nt_sub"
                                android:contentDescription="@null" />

                            <TextView
                                android:id="@+id/tv_hero_platform"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Platform 1"
                                android:textSize="11.5sp"
                                android:textStyle="bold"
                                android:textColor="@color/nt_sub"
                                style="@style/NT.Text" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_after_that"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/nt_gutter"
                android:layout_marginTop="20dp"
                android:text="@string/after_that"
                style="@style/NT.Text.Eyebrow" />

            <LinearLayout
                android:id="@+id/departures_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/nt_gutter"
                android:paddingEnd="@dimen/nt_gutter"
                android:paddingTop="10dp" />

            <TextView
                android:id="@+id/tv_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/no_trains"
                android:visibility="gone"
                style="@style/NT.Text.Body" />
            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <LinearLayout
        android:id="@+id/row_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="@dimen/nt_gutter"
        android:paddingEnd="@dimen/nt_gutter"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_refresh"
            app:tint="@color/nt_muted"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pull_to_refresh"
            style="@style/NT.Text.Caption" />
    </LinearLayout>

</LinearLayout>
