<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.TrainWidget" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/nt_primary</item>
        <item name="colorPrimaryVariant">@color/nt_primary_dark</item>
        <item name="colorOnPrimary">@color/nt_on_primary</item>
        <item name="colorSecondary">@color/nt_secondary</item>
        <item name="colorOnSecondary">@color/nt_on_primary</item>
        <item name="colorSurface">@color/nt_surface</item>
        <item name="colorOnSurface">@color/nt_text</item>
        <item name="colorError">@color/nt_late</item>
        <item name="android:textColorPrimary">@color/nt_text</item>
        <item name="android:textColorSecondary">@color/nt_sub</item>
        <item name="android:textColorHint">@color/nt_muted</item>
        <item name="android:colorBackground">@color/nt_bg</item>
        <!-- The teal header block is gone: the bar takes the page background. -->
        <item name="android:statusBarColor">@color/nt_bg</item>
        <item name="android:navigationBarColor">@color/nt_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <item name="materialCardViewStyle">@style/Widget.NT.Card</item>
        <item name="materialButtonStyle">@style/Widget.NT.Button</item>
        <item name="bottomSheetDialogTheme">@style/Theme.NT.BottomSheet</item>
        <item name="materialAlertDialogTheme">@style/Theme.NT.Dialog</item>
        <item name="textInputStyle">@style/Widget.NT.TextField</item>
    </style>

    <style name="Widget.NT.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/nt_surface</item>
        <item name="cardCornerRadius">@dimen/nt_card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/nt_divider</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Hero card on the dashboard: tinted fill, tinted hairline. -->
    <style name="Widget.NT.Card.Hero" parent="Widget.NT.Card">
        <item name="cardBackgroundColor">@color/nt_primary_soft</item>
        <item name="cardCornerRadius">@dimen/nt_card_radius_hero</item>
        <item name="strokeColor">@color/nt_primary_line</item>
    </style>

    <style name="Widget.NT.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/nt_primary</item>
        <item name="android:textColor">@color/nt_on_primary</item>
        <item name="android:textSize">14.5sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:paddingTop">15dp</item>
        <item name="android:paddingBottom">15dp</item>
        <item name="cornerRadius">@dimen/nt_button_radius</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.NT.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/nt_text</item>
        <item name="strokeColor">@color/nt_divider</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/nt_button_radius</item>
    </style>

    <!-- Destructive confirm action. Filled like the primary button so it carries the
         same weight in a button row, but on the late/alert hue. -->
    <style name="Widget.NT.Button.Danger" parent="Widget.NT.Button">
        <item name="backgroundTint">@color/nt_late</item>
        <item name="android:textColor">@color/nt_on_danger</item>
    </style>

    <style name="Widget.NT.TextField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/nt_field_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/nt_field_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/nt_field_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/nt_field_radius</item>
        <item name="boxStrokeColor">@color/nt_field_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="hintTextColor">@color/nt_muted</item>
    </style>

    <style name="Theme.NT.BottomSheet" parent="Theme.MaterialComponents.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.NT.BottomSheet</item>
        <item name="android:navigationBarColor">@color/nt_surface</item>
    </style>

    <style name="Widget.NT.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@color/nt_surface</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.NT.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.NT.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">26dp</item>
        <item name="cornerSizeTopRight">26dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Theme.NT.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/nt_surface</item>
        <item name="android:textColorPrimary">@color/nt_text</item>
        <item name="android:textColorSecondary">@color/nt_sub</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.NT.Dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.NT.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.NT.DialogButton</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.NT.DialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.NT.DialogBody</item>
    </style>

    <style name="ShapeAppearance.NT.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/nt_card_radius</item>
    </style>

    <style name="TextAppearance.NT.DialogTitle" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/nt_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.NT.DialogBody" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textColor">@color/nt_sub</item>
        <item name="android:textSize">14.5sp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>


    <style name="Theme.NT.TimePicker" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="colorSurface">@color/nt_surface</item>
        <item name="colorAccent">@color/nt_primary</item>
        <item name="android:colorBackground">@color/nt_surface</item>
        <item name="android:windowBackground">@color/nt_surface</item>
        <item name="android:textColorPrimary">@color/nt_text</item>
        <item name="android:textColorSecondary">@color/nt_sub</item>
        <item name="materialButtonStyle">@style/Widget.NT.DialogButton</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.NT.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.NT.DialogButton</item>
    </style>

    <style name="Widget.NT.DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Day picker: 7 circles, not a segmented bar. -->
    <style name="Widget.NT.DayToggle" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/nt_day_toggle_text</item>
        <item name="backgroundTint">@color/nt_day_toggle_bg</item>
        <item name="strokeColor">@color/nt_day_toggle_stroke</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="cornerRadius">22dp</item>
    </style>

    <style name="Widget.NT.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="android:textColor">@color/nt_text</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
